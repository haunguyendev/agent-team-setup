{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "outcome", "plain_summary", "provenance"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["DONE", "BLOCKED", "UNMEASURED", "NO SAFE CHANGE"]},
    "plain_summary": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": [
        "base_commit",
        "agent_model",
        "files_symbols",
        "commands",
        "tests",
        "findings",
        "uncertainty"
      ],
      "properties": {
        "base_commit": {"type": "string", "minLength": 1},
        "agent_model": {"type": "string", "minLength": 1},
        "files_symbols": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["cmd", "exit"],
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "description": "Rerun verbatim by the verifier, without a shell. Use a script for compound commands."
              },
              "exit": {"type": "integer", "description": "The exit code you actually observed."},
              "expected_failure": {
                "type": "boolean",
                "description": "Record a known-bad baseline: a non-zero observed exit then no longer vetoes promotion."
              }
            },
            "additionalProperties": true
          }
        },
        "tests": {"type": "array"},
        "findings": {"type": "array"},
        "uncertainty": {"type": "array"}
      }
    }
  },
  "additionalProperties": true
}
